# Values are printed by `npm run supabase:start` for local development.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-secret-key

# Public URL used in auth redirects. Never put service-role secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_APP_URL=http://localhost:3000